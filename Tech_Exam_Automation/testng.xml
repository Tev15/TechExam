<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    TestNG Suite — Exam Web Application
    Run via Eclipse: Right-click → Run As → TestNG Suite
    Run via Maven:   mvn test
-->
<suite name="Tech Exam Web Application Test Suite" verbose="2" parallel="none">

    <!-- Register the listener for Extent Reports + screenshots on failure -->
    <listeners>
        <listener class-name="com.techexam.webdriver.listeners.TestListener"/>
    </listeners>

    <!-- ============================================================ -->
    <!-- SMOKE TEST GROUP — quick sanity check -->
    <!-- ============================================================ -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.techexam.webdriver.tests.LoginTest"/>
            <class name="com.techexam.webdriver.tests.NavigationTest"/>
        </classes>
    </test>

    <!-- ============================================================ -->
    <!-- FULL REGRESSION SUITE -->
    <!-- ============================================================ -->
    <test name="Authentication Tests">
        <groups>
            <run>
                <include name="auth"/>
            </run>
        </groups>
        <classes>
            <class name="com.techexam.webdriver.tests.LoginTest"/>
        </classes>
    </test>
    
    <test name="Navigation Tests">
        <groups>
            <run>
                <include name="navigation"/>
            </run>
        </groups>
        <classes>
            <class name="com.techexam.webdriver.tests.NavigationTest"/>
        </classes>
    </test>

    <test name="Form and Interaction Tests">
        <groups>
            <run>
                <include name="form"/>
                <include name="errorhandling"/>
            </run>
        </groups>
        <classes>
            <class name="com.techexam.webdriver.tests.FormTest"/>
        </classes>
    </test>
    
    <!-- ============================================================ -->
    <!-- EDGE CASE SUITE -->
    <!-- ============================================================ -->
    
        <test name="Edge Case Tests">
        <groups>
            <run>
                <include name="edge"/>
            </run>
        </groups>
        <classes>
            <class name="com.techexam.webdriver.tests.EdgeCaseTest"/>
        </classes>
    </test>

</suite>
